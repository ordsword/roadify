{
  "name": "roadify",
  "version": "1.1.0",
  "description": "Roadify — The visual roadmap, infinite canvas sprint board & dependency tracking desktop application with built-in MCP server for AI agents.",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "roadify-mcp": "./bin/roadify-mcp.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "mcp": "tsx server/mcp-server.ts",
    "start": "tsx server/index.ts",
    "app": "electron .",
    "app:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.roadify.desktop",
    "productName": "Roadify",
    "artifactName": "Roadify-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "data/**/*",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Roadify",
      "runAfterFinish": true
    }
  },
  "keywords": [
    "roadmap",
    "sprint-board",
    "desktop-app",
    "electron",
    "mcp",
    "model-context-protocol",
    "infinite-canvas",
    "task-management",
    "project-planning",
    "ai-agent",
    "claude-desktop",
    "cursor"
  ],
  "author": "OrdSword <ordsword1@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.3"
  }
}
